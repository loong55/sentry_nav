# 排除build目录
build/

# 排除install目录
install/

# 排除log目录
log/

# 排除src/pb2025_sentry_nav/point_lio/PCD目录下的所有文件
src/pb2025_sentry_nav/point_lio/PCD/*.pcd

# 排除src/pb2025_sentry_nav/pb2025_nav_bringup/map/reality目录下的所有文件
src/pb2025_sentry_nav/pb2025_nav_bringup/map/reality/*.pgm
src/pb2025_sentry_nav/pb2025_nav_bringup/map/reality/*.yaml

# 排除src/pb2025_sentry_nav/pb2025_nav_bringup/pcd/reality目录下的所有文件
src/pb2025_sentry_nav/pb2025_nav_bringup/pcd/reality/*.pcd

# 排除src/pb2025_sentry_nav/pb2025_nav_bringup/pcd/simulation目录下以.pcd结尾的文件
src/pb2025_sentry_nav/pb2025_nav_bringup/pcd/simulation/*.pcd

*.pgm
*.yaml

# 例外：允许跟踪行为树位姿参数（全局 *.yaml 规则会忽略否则）
!src/pb2025_sentry_behavior/params/pose.yaml
!src/pb2025_sentry_behavior/params/pose_rmuc.yaml

# 允许完整跟踪 pb2025_nav_bringup 目录
!src/pb2025_sentry_nav/pb2025_nav_bringup/**

# 仅保留 reality 目录结构，不跟踪其内部数据文件
src/pb2025_sentry_nav/pb2025_nav_bringup/map/reality/*
!src/pb2025_sentry_nav/pb2025_nav_bringup/map/reality/.gitkeep
src/pb2025_sentry_nav/pb2025_nav_bringup/pcd/reality/*
!src/pb2025_sentry_nav/pb2025_nav_bringup/pcd/reality/.gitkeep