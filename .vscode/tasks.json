{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "colcon build",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "source /opt/ros/humble/setup.bash && colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "colcon build pb2025_sentry_behavior",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "source /opt/ros/humble/setup.bash && colcon build --symlink-install --packages-select pb2025_sentry_behavior --cmake-args -DCMAKE_BUILD_TYPE=Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}