<root BTCPP_format="4">
    <TreeNodesModel>
        <Condition ID="CalculateAttackPose">
            <input_port name="costmap_port" type="nav_msgs::msg::OccupancyGrid_&lt;std::allocator&lt;void&gt; &gt;" default="{@nav_globalCostmap}">GlobalCostmap port on blackboard</input_port>
            <input_port name="tracker_port" type="auto_aim_interfaces::msg::Target_&lt;std::allocator&lt;void&gt; &gt;" default="{@tracker_target}">Vision target port on blackboard</input_port>
            <output_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;" default="{attack_pose}">Expected goal pose that send to nav2. Fill with format `x;y;yaw`</output_port>
            <input_port name="min_pub_interval_ms" type="unsigned int" default="0">Minimum publish interval in milliseconds. 0 means publish every tick.</input_port>
            <input_port name="topic_name" type="std::string" default="__default__placeholder__">Topic name</input_port>
        </Condition>
        <Condition ID="IsATKOP">
            <input_port name="op_hp" type="int" default="0">前哨血量</input_port>
            <input_port name="key_port" type="pb_rm_interfaces::msg::GameRobotHP_&lt;std::allocator&lt;void&gt; &gt;" default="{@referee_allRobotHP}">GameRobotHP port on blackboard</input_port>
        </Condition>
        <Condition ID="IsAttacked">
            <output_port name="gimbal_yaw" type="float" default="{gimbal_yaw}">Move gimbal_yaw to the direction of the hit armor plate</output_port>
            <output_port name="gimbal_pitch" type="float" default="{gimbal_pitch}">Move gimbal_pitch (const 0.0) to the direction of the hit armor plate</output_port>
            <input_port name="key_port" type="pb_rm_interfaces::msg::RobotStatus_&lt;std::allocator&lt;void&gt; &gt;" default="{@referee_robotStatus}">RobotStatus port on blackboard</input_port>
        </Condition>
        <Condition ID="IsBaseHPHealthy">
            <input_port name="base_hp_min" type="int" default="3000">Minimum ally base HP</input_port>
            <input_port name="key_port" type="pb_rm_interfaces::msg::GameRobotHP_&lt;std::allocator&lt;void&gt; &gt;" default="{@referee_allRobotHP}">GameRobotHP port on blackboard</input_port>
        </Condition>
        <Condition ID="IsDetectEnemy">
            <input_port name="armor_id" type="std::vector&lt;int, std::allocator&lt;int&gt; &gt;" default="1;2;3;4;5;7">Expected id of armors. Multiple numbers should be separated by the character `;` in Groot2</input_port>
            <input_port name="max_distance" type="float" default="8.000000">Distance to enemy target</input_port>
            <input_port name="key_port" type="auto_aim_interfaces::msg::Armors_&lt;std::allocator&lt;void&gt; &gt;" default="{@detector_armors}">Vision detector port on blackboard</input_port>
        </Condition>
        <Condition ID="IsEnergyEnough">
            <input_port name="remaining_energy" type="int" default="20">剩余能量</input_port>
            <input_port name="key_port" type="pb_rm_interfaces::msg::Buff_&lt;std::allocator&lt;void&gt; &gt;" default="{@referee_buff}">Buff port on blackboard</input_port>
        </Condition>
        <Condition ID="IsGameStatus">
            <input_port name="wait_until_expected" type="bool" default="false">Return RUNNING instead of FAILURE while GameStatus has not reached the expected stage/time</input_port>
            <input_port name="max_remain_time" type="int" default="420">Maximum remaining time (s)</input_port>
            <input_port name="min_remain_time" type="int" default="0">Minimum remaining time (s)</input_port>
            <input_port name="wait_for_message" type="bool" default="false">Return RUNNING instead of FAILURE while waiting for the first GameStatus message</input_port>
            <input_port name="expected_game_progress" type="int" default="4">Expected game progress stage</input_port>
            <input_port name="key_port" type="pb_rm_interfaces::msg::GameStatus_&lt;std::allocator&lt;void&gt; &gt;" default="{@referee_gameStatus}">GameStatus port on blackboard</input_port>
        </Condition>
        <Condition ID="IsHpDeduced">
            <input_port name="key_port" type="pb_rm_interfaces::msg::RobotStatus_&lt;std::allocator&lt;void&gt; &gt;" default="{@referee_robotStatus}">RobotStatus port on blackboard</input_port>
        </Condition>
        <Condition ID="IsOutOfCombat">
            <input_port name="key_port" type="pb_rm_interfaces::msg::RobotStatus_&lt;std::allocator&lt;void&gt; &gt;" default="{@referee_robotStatus}">RobotStatus port on blackboard</input_port>
        </Condition>
        <Condition ID="IsOutpostHPHealthy">
            <input_port name="outpost_hp_min" type="int" default="500">Minimum ally outpost HP</input_port>
            <input_port name="key_port" type="pb_rm_interfaces::msg::GameRobotHP_&lt;std::allocator&lt;void&gt; &gt;" default="{@referee_allRobotHP}">GameRobotHP port on blackboard</input_port>
        </Condition>
        <Condition ID="IsRfidDetected">
            <input_port name="enemy_central_highland_gain_point" type="bool" default="false">对方中央高地增益点</input_port>
            <input_port name="friendly_supply_zone_exchange" type="bool" default="false">己方与兑换区重叠的补给区</input_port>
            <input_port name="friendly_supply_zone_non_exchange" type="bool" default="false">己方与兑换区不重叠的补给区 / RMUL 补给区</input_port>
            <input_port name="center_gain_point" type="bool" default="false">中心增益点（仅 RMUL 适用）</input_port>
            <input_port name="friendly_fortress_gain_point" type="bool" default="false">己方堡垒增益点</input_port>
            <input_port name="key_port" type="pb_rm_interfaces::msg::RfidStatus_&lt;std::allocator&lt;void&gt; &gt;" default="{@referee_rfidStatus}">RfidStatus port on blackboard</input_port>
        </Condition>
        <Condition ID="IsRobotNearPose">
            <input_port name="robot_base_frame" type="std::string" default="chassis">Robot base frame</input_port>
            <input_port name="global_frame" type="std::string" default="map">Global frame for the goal pose</input_port>
            <input_port name="tolerance" type="double" default="0.300000">Position tolerance in meters</input_port>
            <input_port name="goal" type="std::string" default="0;0;0">Target pose in global frame. Fill with format `x;y;yaw`</input_port>
            <input_port name="goal_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Optional: {supply},{fort},… from params/pose.yaml blackboard; overrides [goal]</input_port>
        </Condition>
        <Condition ID="IsShootLocked">
            <input_port name="key_port" type="pb_rm_interfaces::msg::RobotStatus_&lt;std::allocator&lt;void&gt; &gt;" default="{@referee_robotStatus}">RobotStatus port on blackboard</input_port>
        </Condition>
        <Condition ID="IsStatusOK">
            <input_port name="ammo_min" type="int" default="0">Lower then minimum ammo will return FAILURE</input_port>
            <input_port name="hp_min" type="int" default="300">Minimum HP. NOTE: Sentry init/max HP is 400</input_port>
            <input_port name="key_port" type="pb_rm_interfaces::msg::RobotStatus_&lt;std::allocator&lt;void&gt; &gt;" default="{@referee_robotStatus}">RobotStatus port on blackboard</input_port>
        </Condition>
        <Action ID="NavigateThroughPosesAction">
            <output_port name="current_waypoint" type="int">Current waypoint index from feedback</output_port>
            <input_port name="waypoint_file" type="std::string">CSV waypoint file path</input_port>
            <input_port name="frame_id" type="std::string" default="map">Waypoint frame id</input_port>
            <input_port name="action_name" type="std::string" default="navigate_through_poses">Action server name</input_port>
        </Action>
        <Condition ID="NeedSupply">
            <input_port name="exit_ammo_min" type="int" default="200">Exit supply mode when ammo reaches this value</input_port>
            <input_port name="exit_hp_min" type="int" default="350">Exit supply mode when hp reaches this value</input_port>
            <input_port name="enter_ammo_below" type="int" default="20">Enter supply mode when ammo is below this value</input_port>
            <input_port name="enter_hp_below" type="int" default="150">Enter supply mode when hp is below this value</input_port>
            <input_port name="key_port" type="pb_rm_interfaces::msg::RobotStatus_&lt;std::allocator&lt;void&gt; &gt;" default="{@referee_robotStatus}">RobotStatus port on blackboard</input_port>
        </Condition>
        <Condition ID="PubNav2Goal">
            <input_port name="goal_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">When set (e.g. {supply} from params/pose.yaml), overrides [goal]</input_port>
            <input_port name="goal" type="std::string" default="0;0;0">Expected goal pose that send to nav2. Fill with format `x;y;yaw`</input_port>
            <input_port name="frame_id" type="std::string" default="map">Frame id when goal_pose has empty frame_id</input_port>
            <input_port name="min_pub_interval_ms" type="unsigned int" default="0">Minimum publish interval in milliseconds. 0 means publish every tick.</input_port>
            <input_port name="topic_name" type="std::string" default="__default__placeholder__">Topic name</input_port>
        </Condition>
        <Action ID="PublishChassisCmd">
            <input_port name="reset" type="unsigned int" default="0">Reset chassis</input_port>
            <input_port name="vy_limit" type="unsigned int" default="0">Limit chassis y-axis velocity</input_port>
            <input_port name="rotate" type="unsigned int" default="0">Rotate chassis</input_port>
            <input_port name="duration" type="std::chrono::milliseconds" default="">Publish then sleep duration in milliseconds</input_port>
            <input_port name="topic_name" type="std::string" default="__default__placeholder__">Topic name</input_port>
        </Action>
        <Action ID="PublishGimbalAbsolute">
            <input_port name="topic_name" type="std::string" default="__default__placeholder__">Topic name</input_port>
            <input_port name="duration" type="std::chrono::milliseconds">Publish duration</input_port>
            <input_port name="gimbal_yaw" type="float">Expected Yaw angle (rad)</input_port>
            <input_port name="gimbal_pitch" type="float">Expected Pitch angle (rad)</input_port>
        </Action>
        <Action ID="PublishGimbalVelocity">
            <input_port name="duration" type="std::chrono::milliseconds">Publish duration</input_port>
            <input_port name="yaw_min" type="float" default="-3.140000">Minimum yaw range</input_port>
            <input_port name="pitch_min" type="float" default="-1.570000">Minimum pitch range</input_port>
            <input_port name="yaw_max" type="float" default="3.140000">Maximum yaw range</input_port>
            <input_port name="pitch_max" type="float" default="1.570000">Maximum pitch range</input_port>
            <input_port name="gimbal_vel_yaw" type="float" default="0.000000">Yaw velocity (rad/s)</input_port>
            <input_port name="topic_name" type="std::string" default="__default__placeholder__">Topic name</input_port>
            <input_port name="gimbal_vel_pitch" type="float" default="0.000000">Pitch velocity (rad/s)</input_port>
        </Action>
        <Action ID="PublishPostureCmd">
            <input_port name="posture" type="unsigned int" default="3">Posture mode</input_port>
            <input_port name="reason" type="unsigned int" default="0">Posture switch reason</input_port>
            <input_port name="force_switch" type="bool" default="false">Force posture switch</input_port>
            <input_port name="duration" type="std::chrono::milliseconds" default="">Publish then sleep duration in milliseconds</input_port>
            <input_port name="topic_name" type="std::string" default="__default__placeholder__">Topic name</input_port>
        </Action>
        <Action ID="PublishSpinSpeed">
            <input_port name="spin_speed" type="double" default="0.000000">Angular Z velocity (rad/s)</input_port>
            <input_port name="duration" type="std::chrono::milliseconds" default="">Publish then sleep duration in milliseconds</input_port>
            <input_port name="topic_name" type="std::string" default="__default__placeholder__">Topic name</input_port>
        </Action>
        <Action ID="PublishTwist">
            <input_port name="v_y" type="double" default="0.000000">Linear Y velocity (m/s)</input_port>
            <input_port name="v_yaw" type="double" default="0.000000">Angular Z velocity (rad/s)</input_port>
            <input_port name="v_x" type="double" default="0.000000">Linear X velocity (m/s)</input_port>
            <input_port name="duration" type="std::chrono::milliseconds" default="">Publish then sleep duration in milliseconds</input_port>
            <input_port name="topic_name" type="std::string" default="__default__placeholder__">Topic name</input_port>
        </Action>
        <Decorator ID="RateController">
            <input_port name="hz" type="double" default="10.000000">Rate</input_port>
        </Decorator>
        <Control ID="RecoveryNode">
            <input_port name="num_attempts" type="int" default="999">Number of retries</input_port>
        </Control>
        <Action ID="SendNav2Goal">
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;" default="0;0;0">Expected goal pose that send to nav2. Fill with format `x;y;yaw`</input_port>
            <input_port name="action_name" type="std::string" default="">Action server name</input_port>
        </Action>
        <Action ID="SetControllerSpeedLimit">
            <input_port name="timeout_ms" type="unsigned int" default="1000">Parameter service timeout in milliseconds</input_port>
            <input_port name="restore" type="bool" default="false">Restore the cached original vx/vy limits</input_port>
            <input_port name="vy_max" type="double">Maximum absolute linear Y speed after limiting</input_port>
            <input_port name="vx_max" type="double">Maximum absolute linear X speed after limiting</input_port>
            <input_port name="plugin_name" type="std::string" default="FollowPath">Controller plugin name</input_port>
            <input_port name="controller_node" type="std::string" default="controller_server">Nav2 controller node</input_port>
        </Action>
        <Decorator ID="TickAfterTimeout">
            <input_port name="timeout" type="float">time in s to wait before ticking child again</input_port>
        </Decorator>
        <Action ID="WaitUntilReached">
            <input_port name="robot_base_frame" type="std::string" default="chassis">Robot base frame</input_port>
            <input_port name="global_frame" type="std::string" default="map">Global frame for the goal pose</input_port>
            <input_port name="tolerance" type="double" default="0.300000">Position tolerance in meters</input_port>
            <input_port name="goal" type="std::string" default="0;0;0">Target pose in global frame. Fill with format `x;y;yaw`</input_port>
            <input_port name="goal_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Optional: {supply},{fort},... from params/pose.yaml blackboard; overrides [goal]</input_port>
        </Action>
        <Condition ID="pub_nav2_goal_interval">
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;" default="0;0;0">Expected goal pose that send to nav2. Fill with format `x;y;yaw`</input_port>
            <input_port name="frame_id" type="std::string" default="map">Goal frame id</input_port>
            <input_port name="min_pub_interval_ms" type="unsigned int" default="0">Minimum publish interval in milliseconds. 0 means publish every tick.</input_port>
            <input_port name="topic_name" type="std::string" default="__default__placeholder__">Topic name</input_port>
        </Condition>
    </TreeNodesModel>
</root>
