					<PubNav2Goal goal_pose="{@supply_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@supply_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
			</SequenceWithMemory>
		</Sequence>
	</BehaviorTree>

	<BehaviorTree ID="outpost_low_return_from_ramp_side_2026rmuc_out">
		<Sequence>
			<Fallback>
				<IsRobotNearPose goal_pose="{@ramp_base}" tolerance="1.0" global_frame="map" robot_base_frame="chassis"/>
				<IsRobotNearPose goal_pose="{@ramp_base_in}" tolerance="1.2" global_frame="map" robot_base_frame="chassis"/>
				<IsRobotNearPose goal_pose="{@supply}" tolerance="0.8" global_frame="map" robot_base_frame="chassis"/>
			</Fallback>
			<SequenceWithMemory>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
				<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_base_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_base_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@supply_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@supply_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
			</SequenceWithMemory>
		</Sequence>
	</BehaviorTree>

	<BehaviorTree ID="outpost_low_return_to_supply_2026rmuc_out">
		<Fallback>
			<SubTree ID="outpost_low_return_from_highway_box_2026rmuc_out"/>
			<SubTree ID="outpost_low_return_from_highland_side_2026rmuc_out"/>
			<SubTree ID="outpost_low_return_from_highway_out_side_2026rmuc_out"/>
			<SubTree ID="outpost_low_return_from_highway_in_side_2026rmuc_out"/>
			<SubTree ID="outpost_low_return_from_ramp_side_2026rmuc_out"/>
			<!-- 兜底仍走逐点返程，不允许低基地血时直线回拉 -->
			<SubTree ID="outpost_to_supply_blocking_2026rmuc_out"/>
		</Fallback>
	</BehaviorTree>

	<!-- =======================补给区到前哨往返========================== -->
	<BehaviorTree ID="outpost_to_supply_blocking_2026rmuc_out">
		<!-- 阻塞式返程：补给模式进入后，完整走完当前返程分支 -->
		<Fallback>
			<Sequence>
				<IsRobotNearPose goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
			</Sequence>
			<Sequence>
				<IsRobotNearPose goal_pose="{@supply}" tolerance="1.5" global_frame="map" robot_base_frame="chassis"/>
				<Inverter>
					<IsRobotNearPose goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</Inverter>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
				<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
			</Sequence>
			<SequenceWithMemory>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
				<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
				<!-- 前哨-前哨出口-我方高地点-我方前哨-公路出口远处-公路出口，逐点确认避免穿越导航在前两点间回拉 -->
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@outpost_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@outpost_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highland_my}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highland_my}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@outpost_my}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@outpost_my}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highway_out_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highway_out_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highway_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highway_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishChassisCmd topic_name="cmd_chassis" reset="1" rotate="0" vy_limit="0"/>
				<Sleep msec="2000"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="1"/>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highway_in_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highway_in_far}" tolerance="0.6" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
				<!-- 公路入口侧远处-斜坡坡顶-斜坡坡底-斜坡坡底入口-补给区入口-补给区 -->
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_top}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_top}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_base}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_base}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_base_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_base_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@supply_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@supply_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
			</SequenceWithMemory>
		</Fallback>
	</BehaviorTree>

	<BehaviorTree ID="supply_to_outpost_blocking_2026rmuc_out">
		<!-- 阻塞式前进：一旦进入当前分支，不再被同层近区判定反复抢占 -->
		<Fallback>
			<!-- 已经站上前哨或仅有轻微扰动时，保持驻守，不要立刻触发重占振荡 -->
			<Sequence>
				<IsRobotNearPose goal_pose="{@outpost}" tolerance="0.8" global_frame="map" robot_base_frame="chassis"/>
				<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
			</Sequence>

			<!-- 已经进入前哨作战区但被挤开时，直接重发前哨点 -->
			<Sequence>
				<IsRobotNearPose goal_pose="{@outpost}" tolerance="2.0" global_frame="map" robot_base_frame="chassis"/>
				<Inverter>
					<IsRobotNearPose goal_pose="{@outpost}" tolerance="0.8" global_frame="map" robot_base_frame="chassis"/>
				</Inverter>
				<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@outpost}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@outpost}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
			</Sequence>

			<!-- 补给区去前哨记忆序列（高血高弹出发），先判断是否在前哨，再发点 -->
			<SequenceWithMemory>
				<Inverter>
					<IsRobotNearPose goal_pose="{@outpost}" tolerance="0.8" global_frame="map" robot_base_frame="chassis"/>
				</Inverter>
				<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>

				<!-- 补给区-补给区入口-斜坡底部入口-斜坡底部-斜坡顶部-公路入口 -->
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@supply_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@supply_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_base_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_base_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_base}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_base}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_top}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_top}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highway_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highway_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>

				<!-- 公路入口到公路出口速度解锁点，先底盘复位2秒，再限制vy速度，过起伏后恢复速度 -->
				<PublishChassisCmd topic_name="cmd_chassis" reset="1" rotate="0" vy_limit="0"/>
				<Sleep msec="2000"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="1"/>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highway_out_v_unlock}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highway_out_v_unlock}" tolerance="0.5" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>

				<!-- 公路出口速度解锁点-公路出口远处-我方前哨-我方高地-前哨出口-前哨 -->
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highway_out_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highway_out_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@outpost_my}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@outpost_my}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highland_my}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highland_my}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@outpost_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@outpost_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@outpost}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@outpost}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
			</SequenceWithMemory>
		</Fallback>
	</BehaviorTree>

	<BehaviorTree ID="supply_outpost_loop_2026rmuc_out">
		<!-- 反应式选择，下一轮tick无论前面节点啥状态，都会从头tick,直到有一个成功 -->
		<ReactiveFallback>

			<!-- 前哨去补给区记忆序列，低血低弹进入，直到高血高弹才退出 -->
			<SequenceWithMemory>
				<NeedSupply key_port="{@referee_robotStatus}" enter_hp_below="150" enter_ammo_below="20" exit_hp_min="350" exit_ammo_min="200"/>
				<SubTree ID="outpost_to_supply_blocking_2026rmuc_out"/>
			</SequenceWithMemory>

			<SubTree ID="supply_to_outpost_blocking_2026rmuc_out"/>
				
			<!-- 保底选择成功，导致无限循环 -->
			<AlwaysSuccess/>
		</ReactiveFallback>
	</BehaviorTree>

	<!-- ========================= 主行为树 ========================= -->
  <BehaviorTree ID="2026rmuc_out">
    <Sequence>
			<!-- 比赛开始条件，没收到裁判系统消息或在未开赛，都返回running -->
			<SubTree ID="check_game_started_2026rmuc_out"/>
      <!-- 无限循环-->
      <KeepRunningUntilFailure>
        <!-- 反应式选择，下一轮tick无论前面节点啥状态，都会从头tick,直到有一个成功 -->
        <ReactiveFallback>

					<!-- 前哨血量小于20,进入守家策略；-->
					<Sequence>
						<Inverter>
							<IsOutpostHPHealthy outpost_hp_min="20" key_port="{@referee_allRobotHP}"/>
						</Inverter>
						<!-- 前哨血量低于阈值时强制先回补给区，再进入堡垒-补给区往返，不允许回落到推前哨 -->
						<SequenceWithMemory>
							<SubTree ID="outpost_low_return_to_supply_2026rmuc_out"/>
							<Sleep msec="5000"/>
							<KeepRunningUntilFailure>
								<SubTree ID="supply_fort_loop_2026rmuc_out"/>
							</KeepRunningUntilFailure>
						</SequenceWithMemory>
					</Sequence>

					<!-- 前哨血量不低于20,进入推前哨策略-->
					<SubTree ID="supply_outpost_loop_2026rmuc_out"/>

          <!-- 保底选择成功，导致无限循环 -->
          <AlwaysSuccess/>
        </ReactiveFallback>
      </KeepRunningUntilFailure>                                                                             
    </Sequence>  
  </BehaviorTree>
</root>