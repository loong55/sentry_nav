<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
	<BehaviorTree ID="rmul2026">
		<Repeat num_cycles="-1">
			<Sequence>
				<!-- 开赛判断：检测到则立即通过；否则0.1秒/次，3分钟强制开赛 -->
				<ForceSuccess>
					<RetryUntilSuccessful num_attempts="1800">
						<Fallback>
							<IsGameStatus
								expected_game_progress="4"
								key_port="{@referee_gameStatus}"/>
							<!-- 被扣血开赛 -->
							<IsHpDeduced
								key_port="{@referee_robotStatus}"/>
							<ForceFailure>
								<Sleep msec="100"/>
							</ForceFailure>
						</Fallback>
					</RetryUntilSuccessful>
				</ForceSuccess>

				<!-- 检测比赛结束 -->
				<Inverter>
					<IsGameStatus
						expected_game_progress="5"
						key_port="{@referee_gameStatus}"/>
				</Inverter>

				<!-- if(hp >= 380) 发布点A；else if(hp <= 150) 发布起点 -->
				<Fallback>
					<Sequence>
						<IsStatusOK hp_min="380" key_port="{@referee_robotStatus}"/>
						<PubNav2Goal goal="4.8;-2.3;0" topic_name="goal_pose"/>
						<!-- <PubNav2Goal goal="2.5;0;0" topic_name="goal_pose"/> -->
						<Sleep msec="6000"/>
					</Sequence>

					<Sequence>
						<Inverter>
							<IsStatusOK hp_min="151" key_port="{@referee_robotStatus}"/>
						</Inverter>
						<PubNav2Goal goal="0;0;0" topic_name="goal_pose"/>
						<Sleep msec="6000"/>
					</Sequence>

					<!-- 150~379区间不切换目标，避免忙等 -->
					<Sleep msec="100"/>
				</Fallback>
			</Sequence>
		</Repeat>
	</BehaviorTree>
</root>
