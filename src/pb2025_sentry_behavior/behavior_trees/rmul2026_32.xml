<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
	<BehaviorTree ID="check_game_started">
		<Fallback>
			<IsGameStatus
				expected_game_progress="4"
				key_port="{@referee_gameStatus}"/>
			<ForceFailure>
				<Sleep msec="100"/>
			</ForceFailure>
		</Fallback>
	</BehaviorTree>


	<BehaviorTree ID="attack_to_a_then_attack_posture">
		<Sequence>
			<!-- 1.发布进攻点 -->
			<!-- 保守进攻点 -->
			<!-- <PubNav2Goal goal="4.785;-3.01;0" topic_name="goal_pose"/> -->

			<!-- 激进进攻点 -->
			<!-- <PubNav2Goal goal="4.785;-1.51;0" topic_name="goal_pose"/> -->

			<PubNav2Goal goal="1;0;0" topic_name="goal_pose"/>
			<!-- 2. 3秒窗口内并发检测是否装甲板弹丸扣血(ARMOR_HIT=0)，检测到则立即发布进攻姿态 -->
			<Parallel name="wait_and_monitor_armor_hit" threshold="1">
				<Sleep msec="3000"/>
				<RetryUntilSuccessful num_attempts="-1">
					<Sequence name="armor_hit_trigger_attack_posture">
						<Sleep msec="50"/>
						<IsAttacked key_port="{@referee_robotStatus}"/>
						<PublishPostureCmd topic_name="cmd_posture" posture="1" reason="0" force_switch="true"/>
					</Sequence>
				</RetryUntilSuccessful>
			</Parallel>

			<!-- 3. 窗口结束后兜底再发布一次进攻姿态 -->
			<PublishPostureCmd topic_name="cmd_posture" posture="1" reason="0" force_switch="true"/>
		</Sequence>
	</BehaviorTree>


	<BehaviorTree ID="low_hp_recover">
		<Sequence> <!-- 如果有一个子节点返回 FAILURE，则停止执行并返回 FAILURE-->
			<Inverter>
				<IsStatusOK
					hp_min="150"
					key_port="{@referee_robotStatus}"/>
			</Inverter>
			<!-- 检测血量低于150，发布移动姿态-->
			<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
			<!-- 返回起点-->
			<PubNav2Goal goal="1;0;0" topic_name="goal_pose"/>
			<Sleep msec="3000"/>
			<PubNav2Goal goal="0;0;0" topic_name="goal_pose"/>
			<!-- 检测血量，血量>380时，返回success -->
			<RetryUntilSuccessful num_attempts="-1">
				<Sequence>
					<Sleep msec="100"/>
					<IsStatusOK
						hp_min="381"
						key_port="{@referee_robotStatus}"/>
				</Sequence>
			</RetryUntilSuccessful>
		</Sequence>
	</BehaviorTree>

	<BehaviorTree ID="rmul_2026_32">
		<Repeat num_cycles="-1"> <!-- 无限循环 -->
			<Sequence> <!-- Sequence: 顺序执行，有一个子节点失败，中断后续任务。 -->
				<!-- 检测开赛 -->
				<SubTree ID="check_game_started"/>
				<!-- 开赛后，开往进攻点，后发布进攻姿态 -->
				<SubTree ID="attack_to_a_then_attack_posture"/>
				<!-- 开往进攻点后，检测血量，低血量返回起点，恢复到380血量，返回success -->	
				<SubTree ID="low_hp_recover"/>	
			</Sequence>
		</Repeat>
	</BehaviorTree>
</root>
