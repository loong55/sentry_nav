<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="2026rmuc">
  <!-- ========================= 子行为树 ========================= -->	
	<!-- =====比赛开始条件，没收到裁判系统消息或在未开赛，都返回running===== -->
	<BehaviorTree ID="check_game_started_2026rmuc">
		<IsGameStatus min_remain_time="0" max_remain_time="420"
									expected_game_progress="4" key_port="{@referee_gameStatus}"
									wait_for_message="true"	wait_until_expected="true"/>
	</BehaviorTree>

	<!-- ======================= 补给区到堡垒往返 ========================== -->
	<BehaviorTree ID="supply_fort_loop_2026rmuc">
		<!-- 反应式选择，下一轮tick无论前面节点啥状态，都会从头tick,直到有一个成功 -->
		<ReactiveFallback>

			<!-- 低血低弹时持续占住回补分支，直到真的到补给区并补健康 -->
			<SequenceWithMemory>
				<NeedSupply key_port="{@referee_robotStatus}" enter_hp_below="150" enter_ammo_below="20" exit_hp_min="350" exit_ammo_min="200"/>
				<Fallback>
					<Sequence>
						<IsRobotNearPose goal_pose="{@supply}" tolerance="0.25" global_frame="map" robot_base_frame="chassis"/>
						<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
						<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
					</Sequence>			

					<!-- 已经进入补给区但被挤开时，直接重发补给区点 -->
					<Sequence>
						<IsRobotNearPose goal_pose="{@supply}" tolerance="1.5" global_frame="map" robot_base_frame="chassis"/>
						<Inverter>
							<IsRobotNearPose goal_pose="{@supply}" tolerance="0.25" global_frame="map" robot_base_frame="chassis"/>
						</Inverter>
						<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
						<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
						<ReactiveSequence>
							<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
							<WaitUntilReached goal_pose="{@supply}" tolerance="0.25" global_frame="map" robot_base_frame="chassis"/>
						</ReactiveSequence>
						<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
						<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
					</Sequence>

					<!-- 不在以上位置，则执行堡垒-补给区入口-补给区 -->
					<SequenceWithMemory>
						<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
						<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
						<ReactiveSequence>
							<PubNav2Goal goal_pose="{@supply_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
							<WaitUntilReached goal_pose="{@supply_in}" tolerance="0.4" global_frame="map" robot_base_frame="chassis"/>
						</ReactiveSequence>
						<ReactiveSequence>
							<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
							<WaitUntilReached goal_pose="{@supply}" tolerance="0.25" global_frame="map" robot_base_frame="chassis"/>
						</ReactiveSequence>
						<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
						<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
					</SequenceWithMemory>
				</Fallback>
			</SequenceWithMemory>

			<!-- 已经站上堡垒或仅有轻微扰动时，保持驻守，不要立刻触发重占振荡 -->
			<Sequence>
				<IsRobotNearPose goal_pose="{@fort}" tolerance="0.25" global_frame="map" robot_base_frame="chassis"/>
				<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
			</Sequence>

			<!-- 已经进入堡垒作战区但被挤开时，直接重发堡垒点，不回退到补给区侧首点 -->
			<Sequence>
				<IsRobotNearPose goal_pose="{@fort}" tolerance="1.5" global_frame="map" robot_base_frame="chassis"/>
				<Inverter>
					<IsRobotNearPose goal_pose="{@fort}" tolerance="0.25" global_frame="map" robot_base_frame="chassis"/>
				</Inverter>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
				<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@fort}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@fort}" tolerance="0.25" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
			</Sequence>

			<!-- 补给区去堡垒逐点序列（高血高弹出发），每次都先重发补给区入口，避免回血后跳过首点 -->
			<Sequence>
				<Inverter>
					<IsRobotNearPose goal_pose="{@fort}" tolerance="0.25" global_frame="map" robot_base_frame="chassis"/>
				</Inverter>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
				<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@supply_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@supply_in}" tolerance="0.4" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@fort}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@fort}" tolerance="0.25" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
			</Sequence>

			<!-- 保底选择成功，导致无限循环 -->
			<AlwaysSuccess/>
		</ReactiveFallback>
	</BehaviorTree>

  <!-- =======================公路出口回补给区子树========================== -->
	<BehaviorTree ID="highway_out_to_supply_2026rmuc">
		<!-- 反应式选择，下一轮tick无论前面节点啥状态，都会从头tick,直到有一个成功 -->
		<ReactiveFallback>
			<SequenceWithMemory>
				<!-- 导航前先关小陀螺发布移动姿态（3） -->
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
				<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highway_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highway_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<!-- 公路出口-公路入口侧远处，先底盘复位2秒，再限制vy速度，出去后恢复速度 -->
				<PublishChassisCmd topic_name="cmd_chassis" reset="1" rotate="0" vy_limit="0"/>
				<Sleep msec="2000"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="1"/>
				<ReactiveSequence>					
					<PubNav2Goal goal_pose="{@highway_in_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highway_in_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
				<!-- 公路入口侧远处-斜坡坡顶-斜坡坡底-斜坡坡底入口-补给区入口-补给区 -->
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_top}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_top}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_base}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_base}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_base_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_base_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@supply_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@supply_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
			</SequenceWithMemory>			
			<!-- 保底选择成功，导致无限循环 -->
			<AlwaysSuccess/>
		</ReactiveFallback>
	</BehaviorTree>

	<!-- =======================低状态安全回补给区子树========================== -->
	<BehaviorTree ID="state_low_return_to_supply_2026rmuc">
		<ReactiveFallback>
			<!-- 位于公路区间内时，不复位，只限制vy通过公路 -->
			<Sequence>
				<IsRobotInAxisAlignedBox min_x="1.3" max_x="3.77" min_y="-6.9" max_y="-4.97" global_frame="map" robot_base_frame="chassis"/>
				<SequenceWithMemory>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="1"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highway_in_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highway_in_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_top}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_top}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_base}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_base}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_base_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_base_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@supply_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@supply_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
				</SequenceWithMemory>
			</Sequence>

			<!-- 不位于公路中间，位于公路出口/公路出口远处/我方前哨；公路出口远处-公路回补给区-->
			<Sequence>
				<Inverter>
					<IsRobotInAxisAlignedBox min_x="1.3" max_x="3.77" min_y="-6.9" max_y="-4.97" global_frame="map" robot_base_frame="chassis"/>
				</Inverter>
				<Fallback>
					<IsRobotNearPose goal_pose="{@highway_out}" tolerance="1.0" global_frame="map" robot_base_frame="chassis"/>
					<IsRobotNearPose goal_pose="{@highway_out_far}" tolerance="2.0" global_frame="map" robot_base_frame="chassis"/>
					<IsRobotNearPose goal_pose="{@outpost_my}" tolerance="1.5" global_frame="map" robot_base_frame="chassis"/>
				</Fallback>
				<SequenceWithMemory>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highway_out_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highway_out_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>					
				</SequenceWithMemory>
				<SubTree ID="highway_out_to_supply_2026rmuc"/>
			</Sequence>

			<!-- 位于高地入口附近；高地入口-公路出口远处-公路回补给区-->
			<Sequence>
				<Fallback>
					<IsRobotNearPose goal_pose="{@highland_in}" tolerance="2.0" global_frame="map" robot_base_frame="chassis"/>
				</Fallback>
				<SequenceWithMemory>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highland_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highland_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>	
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highway_out_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highway_out_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>					
				</SequenceWithMemory>
				<SubTree ID="highway_out_to_supply_2026rmuc"/>
			</Sequence>

			<!-- 位于我方高地附近；我方高地-我方前哨-公路出口远处-公路回补给区 -->
			<Sequence>
				<Fallback>
					<IsRobotNearPose goal_pose="{@highland_my}" tolerance="1.36" global_frame="map" robot_base_frame="chassis"/>
				</Fallback>
				<SequenceWithMemory>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highland_my}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highland_my}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@outpost_my}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@outpost_my}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highway_out_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highway_out_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
				</SequenceWithMemory>
				<SubTree ID="highway_out_to_supply_2026rmuc"/>
			</Sequence>

			<!-- 位于前哨出口附近；前哨出口-我方高地-我方前哨-公路出口远处-公路回补给区 -->
			<Sequence>
				<Fallback>
					<IsRobotNearPose goal_pose="{@outpost_out}" tolerance="3.0" global_frame="map" robot_base_frame="chassis"/>
				</Fallback>
				<SequenceWithMemory>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@outpost_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@outpost_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highland_my}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highland_my}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@outpost_my}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@outpost_my}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highway_out_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highway_out_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
				</SequenceWithMemory>
				<SubTree ID="highway_out_to_supply_2026rmuc"/>
			</Sequence>

			<!-- 位于前哨附近；前哨-前哨出口-我方高地-我方前哨-公路出口远处-公路回补给区 -->
			<Sequence>
				<Fallback>
					<IsRobotNearPose goal_pose="{@outpost}" tolerance="2.5" global_frame="map" robot_base_frame="chassis"/>
				</Fallback>
				<SequenceWithMemory>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@outpost_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@outpost_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highland_my}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highland_my}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@outpost_my}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@outpost_my}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highway_out_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highway_out_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
				</SequenceWithMemory>
				<SubTree ID="highway_out_to_supply_2026rmuc"/>
			</Sequence>

			<!-- 位于高地附近；高地-高地入口-公路出口远处-公路回补给区 -->
			<Sequence>
				<Fallback>
					<IsRobotNearPose goal_pose="{@highland}" tolerance="2.5" global_frame="map" robot_base_frame="chassis"/>
				</Fallback>
				<SequenceWithMemory>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highland}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highland}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highland_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highland_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highway_out_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highway_out_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
				</SequenceWithMemory>
				<SubTree ID="highway_out_to_supply_2026rmuc"/>
			</Sequence>

			<!-- 位于公路入口远处或斜坡顶部附近，公路入口远处-补给区 -->
			<Sequence>
				<Inverter>
					<IsRobotInAxisAlignedBox min_x="1.3" max_x="3.77" min_y="-6.9" max_y="-4.97" global_frame="map" robot_base_frame="chassis"/>
				</Inverter>
				<Fallback>
					<IsRobotNearPose goal_pose="{@highway_in_far}" tolerance="1.2" global_frame="map" robot_base_frame="chassis"/>
					<IsRobotNearPose goal_pose="{@ramp_top}" tolerance="1.4" global_frame="map" robot_base_frame="chassis"/>
				</Fallback>
				<SequenceWithMemory>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highway_in_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highway_in_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_top}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_top}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_base}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_base}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_base_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_base_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@supply_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@supply_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
				</SequenceWithMemory>
			</Sequence>

			<!-- 位于坡底附近，坡底-补给区 -->
			<Sequence>
				<Fallback>
					<IsRobotNearPose goal_pose="{@ramp_base}" tolerance="2.2" global_frame="map" robot_base_frame="chassis"/>
				</Fallback>
				<SequenceWithMemory>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_base}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_base}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>					
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_base_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_base_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@supply_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@supply_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
				</SequenceWithMemory>
			</Sequence>

			<!-- 位于坡底入口附近，坡底入口-补给区 -->
			<Sequence>
				<Fallback>
					<IsRobotNearPose goal_pose="{@ramp_base_in}" tolerance="2.6" global_frame="map" robot_base_frame="chassis"/>
				</Fallback>
				<SequenceWithMemory>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>				
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_base_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_base_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@supply_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@supply_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
				</SequenceWithMemory>
			</Sequence>		

			<!-- 位于补给区入口/补给区/堡垒附近，补给区入口-补给区 -->
			<Sequence>
				<Fallback>
					<IsRobotNearPose goal_pose="{@supply_in}" tolerance="2.2" global_frame="map" robot_base_frame="chassis"/>
					<IsRobotNearPose goal_pose="{@supply}" tolerance="1.0" global_frame="map" robot_base_frame="chassis"/>
					<IsRobotNearPose goal_pose="{@fort}" tolerance="3.2" global_frame="map" robot_base_frame="chassis"/>
				</Fallback>
				<SequenceWithMemory>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@supply_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@supply_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
				</SequenceWithMemory>
			</Sequence>

			<!-- 保底选择成功，导致无限循环 -->
			<AlwaysSuccess/>
		</ReactiveFallback>
	</BehaviorTree>

	<!-- =======================补给区到前哨往返========================== -->
	<BehaviorTree ID="supply_outpost_loop_2026rmuc">
		<!-- 反应式选择，下一轮tick无论前面节点啥状态，都会从头tick,直到有一个成功 -->
		<ReactiveFallback>

			<!-- 前哨回补给区反应式序列，低血低弹时持续门控，回血后立刻退出回补 -->
			<SequenceWithMemory>
				<NeedSupply key_port="{@referee_robotStatus}" enter_hp_below="150" enter_ammo_below="20" exit_hp_min="350" exit_ammo_min="200"/>
				<Fallback>
					<!-- 在补给区，关移动姿态回血-->
					<Sequence>
						<IsRobotNearPose goal_pose="{@supply}" tolerance="0.25" global_frame="map" robot_base_frame="chassis"/>
						<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
						<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					</Sequence>
					<!-- 在补给区附近但不在补给区内部（防止被挤开），自动回去-->
					<Sequence>
						<Fallback>
							<IsRobotNearPose goal_pose="{@supply}" tolerance="1.0" global_frame="map" robot_base_frame="chassis"/>
						</Fallback>
						<Inverter>
							<IsRobotNearPose goal_pose="{@supply}" tolerance="0.25" global_frame="map" robot_base_frame="chassis"/>
						</Inverter>
						<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
						<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
						<ReactiveSequence>
							<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
							<WaitUntilReached goal_pose="{@supply}" tolerance="0.25" global_frame="map" robot_base_frame="chassis"/>
						</ReactiveSequence>
						<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
						<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					</Sequence>
					<!-- 不在补给区附近，用低状态回补给区子树-->
					<SubTree ID="state_low_return_to_supply_2026rmuc"/>
				</Fallback>
			</SequenceWithMemory>

			<!-- 已经站上前哨或仅有轻微扰动时，保持驻守，不要立刻触发重占振荡 -->
			<Sequence>
				<IsRobotNearPose goal_pose="{@outpost}" tolerance="0.4" global_frame="map" robot_base_frame="chassis"/>
				<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
			</Sequence>

			<!-- 已经进入前哨作战区（3m）但被挤开时，直接重发前哨点，不回退到补给侧首点 -->
			<Sequence>
				<IsRobotNearPose goal_pose="{@outpost}" tolerance="3.0" global_frame="map" robot_base_frame="chassis"/>
				<Inverter>
					<IsRobotNearPose goal_pose="{@outpost}" tolerance="0.3" global_frame="map" robot_base_frame="chassis"/>
				</Inverter>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
				<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@outpost}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@outpost}" tolerance="0.3" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
			</Sequence>

			<!-- 补给区去前哨逐点序列（高血高弹出发），回血后强制从补给区首段重新走，避免直接续到前哨终点 -->
			<SequenceWithMemory>
				<!-- 判断是否在前哨作门控，3.0m门控，防止下次在前哨时，直接从家出发，导航前发布移动姿态 -->
				<Inverter>
					<IsRobotNearPose goal_pose="{@outpost}" tolerance="3.0" global_frame="map" robot_base_frame="chassis"/>
				</Inverter>				
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
				<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>

				<!-- 补给区-补给区入口-斜坡坡底入口-斜坡底部-斜坡顶部-公路入口 -->
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@supply_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@supply_in}" tolerance="0.5" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>				 
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_base_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_base_in}" tolerance="0.6" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_base}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_base}" tolerance="0.4" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_top}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_top}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highway_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highway_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>

				<!-- 公路入口到公路出口速度解锁点，先底盘复位2秒，再限制vy速度，过起伏后恢复速度-->
				<PublishChassisCmd topic_name="cmd_chassis" reset="1" rotate="0" vy_limit="0"/>
				<Sleep msec="2000"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="1"/>
				<ReactiveSequence>					
					<PubNav2Goal goal_pose="{@highway_out_v_unlock}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highway_out_v_unlock}" tolerance="1.0" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
				<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>

				<!-- 公路出口速度解锁点-公路出口远处-高地入口-高地-前哨，逐点确认避免穿越导航在前两点间回拉 -->
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highway_out_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highway_out_far}" tolerance="0.5" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>	
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highland_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highland_in}" tolerance="0.5" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>				 
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highland}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highland}" tolerance="0.6" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@outpost}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@outpost}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>

				<!-- 到达前哨后，先关移动姿态，再开小陀螺 -->
        <PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
			</SequenceWithMemory>  
				
			<!-- 保底选择成功，导致无限循环 -->
			<AlwaysSuccess/>
		</ReactiveFallback>
	</BehaviorTree>

	<!-- ========================= 主行为树 ========================= -->
  <BehaviorTree ID="2026rmuc">
    <Sequence>
			<!-- 比赛开始条件，没收到裁判系统消息或在未开赛，都返回running -->
			<SubTree ID="check_game_started_2026rmuc"/>
      <!-- 无限循环-->
      <KeepRunningUntilFailure>
        <!-- 反应式选择，下一轮tick无论前面节点啥状态，都会从头tick,直到有一个成功 -->
        <ReactiveFallback>

					<!-- 基地血量小于2500,进入守家策略；-->
					<Sequence>
						<Inverter>
							<IsBaseHPHealthy base_hp_min="2500" key_port="{@referee_allRobotHP}"/>
						</Inverter>
						<SubTree ID="state_low_return_to_supply_2026rmuc"/>
						<Sleep msec="5000"/>
						<!-- 低基地血时强制先回补给区，再进入堡垒-补给区往返 -->
						<KeepRunningUntilFailure>
							<Sequence>
								<Inverter>
									<IsBaseHPHealthy base_hp_min="2500" key_port="{@referee_allRobotHP}"/>
								</Inverter>
								<SubTree ID="supply_fort_loop_2026rmuc"/>
							</Sequence>
						</KeepRunningUntilFailure>
					</Sequence>

					<!-- 前哨血量低于50，进入守家策略； -->
					<Sequence>
						<Inverter>
							<IsOutpostHPHealthy outpost_hp_min="50" key_port="{@referee_allRobotHP}"/>
						</Inverter>
						<SubTree ID="state_low_return_to_supply_2026rmuc"/>
						<Sleep msec="5000"/>
						<KeepRunningUntilFailure>
							<Sequence>
								<Inverter>
									<IsOutpostHPHealthy outpost_hp_min="50" key_port="{@referee_allRobotHP}"/>
								</Inverter>
								<SubTree ID="supply_fort_loop_2026rmuc"/>
							</Sequence>
						</KeepRunningUntilFailure>
					</Sequence>

					<!-- 基地和前哨健康，进入推前哨策略 -->
					<SubTree ID="supply_outpost_loop_2026rmuc"/>

          <!-- 保底选择成功，导致无限循环 -->
          <AlwaysSuccess/>
        </ReactiveFallback>
      </KeepRunningUntilFailure>                                                                             
    </Sequence>  
  </BehaviorTree>
</root>