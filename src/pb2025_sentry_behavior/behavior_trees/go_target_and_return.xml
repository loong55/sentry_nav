<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="go_target_and_return">
    <Sequence>
      <NavigateThroughPosesAction
        action_name="navigate_through_poses"
        waypoint_file="behavior_trees/waypoints/go_target.csv"
        frame_id="map"
        current_waypoint="{go_current_waypoint}"/>

      <NavigateThroughPosesAction
        action_name="navigate_through_poses"
        waypoint_file="behavior_trees/waypoints/return_home.csv"
        frame_id="map"
        current_waypoint="{return_current_waypoint}"/>
    </Sequence>
  </BehaviorTree>
</root>