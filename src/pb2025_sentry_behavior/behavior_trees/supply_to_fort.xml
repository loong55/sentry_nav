<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="supply_to_fort">
  <BehaviorTree ID="supply_to_fort">
    <Sequence>
      <!-- 多点导航，开局直接去堡垒 -->
			<NavigateThroughPosesAction
				action_name="navigate_through_poses"
				waypoint_file="behavior_trees/waypoints/supply_to_port.csv"
				frame_id="map"
				current_waypoint="{return_current_waypoint}"/>

      <!-- 无限循环-->
      <KeepRunningUntilFailure>
        <!-- 反应式选择，下一轮tick无论前面节点啥状态，都会从头tick,直到有一个成功 -->
        <ReactiveFallback>

					<!-- 低状态回家序列，先判断低状态，再反应式序列回补给区同时判断高状态 -->
					<Sequence>
						<!-- 第一个节点（低状态判断）成功，下一轮不会tick，除非全部成功，会从头tick-->
						<Inverter>
							<IsStatusOK ammo_min="20" hp_min="150" key_port="{@referee_robotStatus}"/>
						</Inverter>
						<!-- 反应式序列，每轮tick，不论内部节点啥状态，都会从头tick到尾，直到全部成功-->
						<ReactiveSequence>
							<PubNav2Goal goal="1.76;-4.56;0.0" topic_name="goal_pose" min_pub_interval_ms="500"/>
							<!-- 判断是否回满状态，回满了全部成功，下轮tick不再去补给区-->					
							<IsStatusOK ammo_min="200" hp_min="350" key_port="{@referee_robotStatus}"/>
						</ReactiveSequence>
					</Sequence>

					<!-- 高状态去堡垒反应式序列，先判断是否在堡垒，再发点；每轮tick，不论内部节点啥状态，都会从头tick到尾，直到全部成功 -->
					<ReactiveSequence>
						<!-- 第一个节点（位置判断）成功，下一轮tick会继续判断位置，直到全部成功 -->
						<Inverter>
							<IsRobotNearPose goal="2.67;0.58;0.0"
													 tolerance="0.2"
													 global_frame="map"
													 robot_base_frame="chassis"/>
						</Inverter>
						<!-- 每0.5秒发布一次，发布后立刻返回success，然后0.5秒内不tick此节点 -->
						<PubNav2Goal goal="2.67;0.58;0.0" topic_name="goal_pose" min_pub_interval_ms="500"/> 						
					</ReactiveSequence>  

          <!-- 保底选择成功，导致无限循环 -->
          <AlwaysSuccess/>
        </ReactiveFallback>
      </KeepRunningUntilFailure>                                                                             
    </Sequence>  
  </BehaviorTree>
</root>