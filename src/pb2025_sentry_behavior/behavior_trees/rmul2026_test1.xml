<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
	<BehaviorTree ID="rmul2026_test1">
		<Repeat num_cycles="-1"> <!-- 无限循环 -->
			<Sequence> <!-- Sequence: 顺序执行，有一个子节点失败，中断后续任务。 -->
				<!-- 检测开赛 -->
				<!-- <Fallback> -->
					<!-- <IsGameStatus -->
						<!-- expected_game_progress="4" -->
						<!-- key_port="{@referee_gameStatus}"/> -->
					<!-- <IsHpDeduced -->
						<!-- key_port="{@referee_robotStatus}"/> -->
					<!-- <ForceFailure> -->
						<!-- <Sleep msec="100"/> -->
					<!-- </ForceFailure> -->
				<!-- </Fallback> -->

				<!-- 2分钟后必定开赛，如果两分钟内检测到开赛,立刻启动 -->
				<RetryUntilSuccessful num_attempts="10">
					<Fallback>
						<IsGameStatus
							expected_game_progress="4"
							key_port="{@referee_gameStatus}"/>
						<!-- 被扣血开赛 -->
						<IsHpDeduced
							key_port="{@referee_robotStatus}"/>
						<ForceFailure>
							<Sleep msec="100"/>
						</ForceFailure>
					</Fallback>
				</RetryUntilSuccessful>

				<!-- 检测比赛结束 -->
				<Inverter>
					<IsGameStatus
						expected_game_progress="5"
						key_port="{@referee_gameStatus}"/>
				</Inverter>

				<IsStatusOK
					hp_min="381"
					key_port="{@referee_robotStatus}"/>

				<!--  开往进攻点 -->	
				<PubNav2Goal goal="2.5;-2.7;0" topic_name="goal_pose"/> 
				
				<!-- 连续检测10秒：血量<150，返回SUCCESS进入下一条 -->
				<RetryUntilSuccessful num_attempts="-1">
					<Fallback>
						<Inverter>
							<IsStatusOK
								hp_min="150"
								key_port="{@referee_robotStatus}"/>
						</Inverter>
						<ForceFailure>
							<Sleep msec="100"/>
						</ForceFailure>
					</Fallback>
				</RetryUntilSuccessful>

				<Inverter>
					<IsStatusOK
						hp_min="150"
						key_port="{@referee_robotStatus}"/>
				</Inverter>				

				<!--  开往起点 -->
				<PubNav2Goal goal="0;0;0" topic_name="goal_pose"/>

				<!-- 连续检测10秒：血量>380，返回SUCCESS，进入下一条 -->
				<RetryUntilSuccessful num_attempts="100">
					<Fallback>
						<IsStatusOK
							hp_min="381"
							key_port="{@referee_robotStatus}"/>
						<ForceFailure>
							<Sleep msec="100"/>
						</ForceFailure>
					</Fallback>
				</RetryUntilSuccessful>

				<IsStatusOK
					hp_min="381"
					key_port="{@referee_robotStatus}"/>

			</Sequence>
		</Repeat>
	</BehaviorTree>
</root>
