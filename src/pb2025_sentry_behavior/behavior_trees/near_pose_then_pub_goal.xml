<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="near_pose_then_pub_goal">
    <ReactiveFallback>
      <IsRobotNearPose goal="1.0;0.0;0.0"
                       tolerance="0.3"
                       global_frame="map"
                       robot_base_frame="chassis"/>
      <pub_nav2_goal_interval goal="1.0;0.0;0.0"
                              frame_id="map"
                              topic_name="goal_pose" 
                              min_pub_interval_ms="500"/> 
      <!-- 每0.5秒发布一次，第一次 tick：发布 goal，返回 SUCCESS；500ms 内后续 tick：不发布，直接返回 SUCCESS；超过 500ms 后下一次 tick：再次发布，返回 SUCCESS-->
    </ReactiveFallback>
  </BehaviorTree>
</root>