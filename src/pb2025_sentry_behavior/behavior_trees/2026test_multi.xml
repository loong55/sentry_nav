<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="2026test_multi">
  <!-- ========================= 子行为树 ========================= -->	
	<!-- =====比赛开始条件，没收到裁判系统消息或在未开赛，都返回running===== -->
	<BehaviorTree ID="check_game_started_2026test_multi">
		<IsGameStatus min_remain_time="0" max_remain_time="420"
									expected_game_progress="4" key_port="{@referee_gameStatus}"
									wait_for_message="true"	wait_until_expected="true"/>
	</BehaviorTree>

	<!-- ======================= 补给区到堡垒往返 ========================== -->
	<BehaviorTree ID="supply_fort_loop_2026test_multi">
		<!-- 反应式选择，下一轮tick无论前面节点啥状态，都会从头tick,直到有一个成功 -->
		<ReactiveFallback>

			<!-- 低血低弹时持续占住回补分支，直到真的到补给区并补健康 -->
			<Sequence>
				<NeedSupply key_port="{@referee_robotStatus}" enter_hp_below="150" enter_ammo_below="20" exit_hp_min="350" exit_ammo_min="200"/>
				<Fallback>
					<Sequence>
						<IsRobotNearPose goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
						<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
						<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					</Sequence>
					<Sequence>
						<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
						<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
						<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					</Sequence>
				</Fallback>
			</Sequence>

			<!-- 高状态去堡垒反应式选择，先判断是否在堡垒，再发点；每轮tick，不论内部节点啥状态，都会从头tick到尾，直到全部成功 -->
			<ReactiveFallback>				
				<Sequence>
					<!-- 判断是否到达堡垒，到达则关移动姿态开小陀螺，未到达则跳过 -->
					<IsRobotNearPose goal_pose="{@fort}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
				</Sequence>  

				<Sequence>
					<!-- 导航前确保不是小陀螺，并切到移动姿态 -->
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
					<PubNav2Goal goal_pose="{@fort}" topic_name="goal_pose" min_pub_interval_ms="500"/>
				</Sequence>   						
			</ReactiveFallback>  

			<!-- 保底选择成功，导致无限循环 -->
			<AlwaysSuccess/>
		</ReactiveFallback>
	</BehaviorTree>

  <!-- =======================前哨去补给区子树========================== -->
	<BehaviorTree ID="outpost_to_supply_2026test_multi">
		<!-- 反应式选择，下一轮tick无论前面节点啥状态，都会从头tick,直到有一个成功 -->
		<ReactiveFallback>
			<SequenceWithMemory>

				<!-- 导航前先关小陀螺发布移动姿态（3） -->
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
				<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
				<!-- 前哨-我方高地点-我方前哨-高地入口-公路出口 -->
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highland_my}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highland_my}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@outpost_my}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@outpost_my}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highland_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highland_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highway_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highway_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<!-- 公路出口-公路入口侧远处，先底盘复位2秒，再限制vy速度，出去后恢复速度 -->
				<PublishChassisCmd topic_name="cmd_chassis" reset="1" rotate="0" vy_limit="0"/>
				<Sleep msec="2000"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="1"/>
				<ReactiveSequence>					
					<PubNav2Goal goal_pose="{@highway_in_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highway_in_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
				<!-- 公路入口侧远处-斜坡坡顶-斜坡坡底-堡垒出口侧-补给区 -->
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_top}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_top}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_base}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_base}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@fort_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@fort_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>

			</SequenceWithMemory>			
			<!-- 保底选择成功，导致无限循环 -->
			<AlwaysSuccess/>
		</ReactiveFallback>
	</BehaviorTree>

	<!-- =======================基地低血时安全回补给区========================== -->
	<BehaviorTree ID="base_low_return_to_supply_2026test_multi">
		<ReactiveFallback>
			<!-- 位于公路区间内时，不复位，只限制vy通过公路 -->
			<Sequence>
				<IsRobotInAxisAlignedBox min_x="-0.10" max_x="2.80" min_y="-3.55" max_y="-3.05" global_frame="map" robot_base_frame="chassis"/>
				<SequenceWithMemory>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="1"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highway_in_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highway_in_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_top}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_top}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_base}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_base}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@fort_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@fort_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
				</SequenceWithMemory>
			</Sequence>

			<!-- 已经在高地/前哨一侧时，先回高地入口，再过公路回补给 -->
			<Sequence>
				<Fallback>
					<IsRobotNearPose goal_pose="{@outpost}" tolerance="2.0" global_frame="map" robot_base_frame="chassis"/>
					<IsRobotNearPose goal_pose="{@highland}" tolerance="1.2" global_frame="map" robot_base_frame="chassis"/>
					<IsRobotNearPose goal_pose="{@highland_in}" tolerance="1.0" global_frame="map" robot_base_frame="chassis"/>
				</Fallback>
				<SequenceWithMemory>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highland}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highland}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highland_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highland_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highway_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highway_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<PublishChassisCmd topic_name="cmd_chassis" reset="1" rotate="0" vy_limit="0"/>
					<Sleep msec="2000"/>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="1"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highway_in_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highway_in_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_top}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_top}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_base}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_base}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@fort_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@fort_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
				</SequenceWithMemory>
			</Sequence>

			<!-- 不在公路区间内但还在出口外侧时，先复位2秒，再限vy通过公路 -->
			<Sequence>
				<Inverter>
					<IsRobotInAxisAlignedBox min_x="-0.10" max_x="2.80" min_y="-3.55" max_y="-3.05" global_frame="map" robot_base_frame="chassis"/>
				</Inverter>
				<IsRobotNearPose goal_pose="{@highway_out}" tolerance="1.0" global_frame="map" robot_base_frame="chassis"/>
				<SequenceWithMemory>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
					<PublishChassisCmd topic_name="cmd_chassis" reset="1" rotate="0" vy_limit="0"/>
					<Sleep msec="2000"/>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="1"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highway_in_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highway_in_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_top}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_top}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_base}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_base}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@fort_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@fort_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
				</SequenceWithMemory>
			</Sequence>

			<!-- 已经回到公路补给侧附近时，直接按剩余点位回补给 -->
			<Sequence>
				<Fallback>
					<IsRobotNearPose goal_pose="{@highway_in_far}" tolerance="0.5" global_frame="map" robot_base_frame="chassis"/>
					<IsRobotNearPose goal_pose="{@ramp_top}" tolerance="1.0" global_frame="map" robot_base_frame="chassis"/>
				</Fallback>
				<SequenceWithMemory>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@highway_in_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@highway_in_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_top}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_top}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_base}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_base}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@fort_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@fort_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
				</SequenceWithMemory>
			</Sequence>

			<!-- 已经过了斜坡/堡垒出口一侧时，直接按剩余点位回补给 -->
			<Sequence>
				<Fallback>
					<IsRobotNearPose goal_pose="{@ramp_base}" tolerance="1.0" global_frame="map" robot_base_frame="chassis"/>
					<IsRobotNearPose goal_pose="{@fort_out}" tolerance="1.2" global_frame="map" robot_base_frame="chassis"/>
					<IsRobotNearPose goal_pose="{@supply}" tolerance="0.8" global_frame="map" robot_base_frame="chassis"/>
				</Fallback>
				<SequenceWithMemory>
					<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@ramp_base}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@ramp_base}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@fort_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@fort_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
					<ReactiveSequence>
						<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
						<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
					</ReactiveSequence>
				</SequenceWithMemory>
			</Sequence>

			<!-- 兜底仍走逐点返程，不允许低基地血时直线回拉 -->
			<SubTree ID="outpost_to_supply_2026test_multi"/>
		</ReactiveFallback>
	</BehaviorTree>

	<!-- =======================补给区到前哨往返========================== -->
	<BehaviorTree ID="supply_outpost_loop_2026test_multi">
		<!-- 反应式选择，下一轮tick无论前面节点啥状态，都会从头tick,直到有一个成功 -->
		<ReactiveFallback>

			<!-- 前哨去补给区记忆序列，低血低弹进入，直到高血高弹才退出 -->
			<SequenceWithMemory>
				<NeedSupply key_port="{@referee_robotStatus}" enter_hp_below="150" enter_ammo_below="20" exit_hp_min="350" exit_ammo_min="200"/>
				<!-- 已到补给区时保持在补给区，直到 NeedSupply 退出，避免没补满就切回推前哨 -->
				<Fallback>
					<Sequence>
						<IsRobotNearPose goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
						<PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
						<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
					</Sequence>
					<SequenceWithMemory>
						<!-- 导航前先关小陀螺发布移动姿态（3） -->
						<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
						<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>
						<!-- 前哨-我方高地点-我方前哨-高地入口-公路出口，逐点确认避免穿越导航在前两点间回拉 -->
						<ReactiveSequence>
							<PubNav2Goal goal_pose="{@highland_my}" topic_name="goal_pose" min_pub_interval_ms="500"/>
							<WaitUntilReached goal_pose="{@highland_my}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
						</ReactiveSequence>
						<ReactiveSequence>
							<PubNav2Goal goal_pose="{@outpost_my}" topic_name="goal_pose" min_pub_interval_ms="500"/>
							<WaitUntilReached goal_pose="{@outpost_my}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
						</ReactiveSequence>
						<ReactiveSequence>
							<PubNav2Goal goal_pose="{@highland_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
							<WaitUntilReached goal_pose="{@highland_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
						</ReactiveSequence>
						<ReactiveSequence>
							<PubNav2Goal goal_pose="{@highway_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
							<WaitUntilReached goal_pose="{@highway_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
						</ReactiveSequence>
						<!-- 公路出口-公路入口侧远处，先底盘复位2秒，再限制vy速度，出去后恢复速度 -->
						<PublishChassisCmd topic_name="cmd_chassis" reset="1" rotate="0" vy_limit="0"/>
						<Sleep msec="2000"/>
						<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="1"/>
						<ReactiveSequence>
							<PubNav2Goal goal_pose="{@highway_in_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
							<WaitUntilReached goal_pose="{@highway_in_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
						</ReactiveSequence>
						<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>
						<!-- 公路入口侧远处-斜坡坡顶-斜坡坡底-堡垒出口侧-补给区，逐点确认避免穿越导航在前两点间回拉 -->
						<ReactiveSequence>
							<PubNav2Goal goal_pose="{@ramp_top}" topic_name="goal_pose" min_pub_interval_ms="500"/>
							<WaitUntilReached goal_pose="{@ramp_top}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
						</ReactiveSequence>
						<ReactiveSequence>
							<PubNav2Goal goal_pose="{@ramp_base}" topic_name="goal_pose" min_pub_interval_ms="500"/>
							<WaitUntilReached goal_pose="{@ramp_base}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
						</ReactiveSequence>
						<ReactiveSequence>
							<PubNav2Goal goal_pose="{@fort_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
							<WaitUntilReached goal_pose="{@fort_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
						</ReactiveSequence>
						<ReactiveSequence>
							<PubNav2Goal goal_pose="{@supply}" topic_name="goal_pose" min_pub_interval_ms="500"/>
							<WaitUntilReached goal_pose="{@supply}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
						</ReactiveSequence>
					</SequenceWithMemory>
				</Fallback>
			</SequenceWithMemory>

			<!-- 补给区去前哨记忆序列（高血高弹出发），先判断是否在前哨，再发点 -->
			<SequenceWithMemory>
				<!-- 判断是否在前哨作门控，导航前发布移动姿态 -->
				<Inverter>
					<IsRobotNearPose goal_pose="{@outpost}" tolerance="0.5" global_frame="map" robot_base_frame="chassis"/>
				</Inverter>				
				<PublishPostureCmd topic_name="cmd_posture" posture="3" reason="0" force_switch="true"/>

				<!-- 补给区-堡垒出口-斜坡底部-斜坡顶部-公路路口侧远处-公路入口 -->
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@fort_out}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@fort_out}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_base}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_base}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@ramp_top}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@ramp_top}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highway_in_far}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highway_in_far}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highway_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highway_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>

				<!-- 公路入口到高地入口，先底盘复位2秒，再限制vy速度，过起伏后恢复速度-->
				<PublishChassisCmd topic_name="cmd_chassis" reset="1" rotate="0" vy_limit="0"/>
				<Sleep msec="2000"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="1"/>
				<ReactiveSequence>					
					<PubNav2Goal goal_pose="{@highland_in}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highland_in}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="0" vy_limit="0"/>

				<!-- 高地入口-高地-前哨，逐点确认避免穿越导航在前两点间回拉 -->
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@highland}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@highland}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>
				<ReactiveSequence>
					<PubNav2Goal goal_pose="{@outpost}" topic_name="goal_pose" min_pub_interval_ms="500"/>
					<WaitUntilReached goal_pose="{@outpost}" tolerance="0.35" global_frame="map" robot_base_frame="chassis"/>
				</ReactiveSequence>

				<!-- 到达前哨后，先关移动姿态，再开小陀螺 -->
        <PublishPostureCmd topic_name="cmd_posture" posture="0" reason="0" force_switch="true"/>
				<PublishChassisCmd topic_name="cmd_chassis" reset="0" rotate="1" vy_limit="0"/>
			</SequenceWithMemory>  
				
			<!-- 保底选择成功，导致无限循环 -->
			<AlwaysSuccess/>
		</ReactiveFallback>
	</BehaviorTree>

	<!-- ========================= 主行为树 ========================= -->
  <BehaviorTree ID="2026test_multi">
    <Sequence>
			<!-- 比赛开始条件，没收到裁判系统消息或在未开赛，都返回running -->
			<SubTree ID="check_game_started_2026test_multi"/>
      <!-- 无限循环-->
      <KeepRunningUntilFailure>
        <!-- 反应式选择，下一轮tick无论前面节点啥状态，都会从头tick,直到有一个成功 -->
        <ReactiveFallback>

					<!-- 基地血量小于2500,进入守家策略；-->
					<Sequence>
						<Inverter>
							<IsBaseHPHealthy base_hp_min="2500" key_port="{@referee_allRobotHP}"/>
						</Inverter>
						<!-- 低基地血时强制先回补给区，再进入堡垒-补给区往返，不允许回落到推前哨 -->
						<SequenceWithMemory>
							<SubTree ID="base_low_return_to_supply_2026test_multi"/>
							<Sleep msec="5000"/>
							<KeepRunningUntilFailure>
								<SubTree ID="supply_fort_loop_2026test_multi"/>
							</KeepRunningUntilFailure>
						</SequenceWithMemory>
					</Sequence>

					<!-- 基地血量大于2500,进入推前哨策略-->
					<SubTree ID="supply_outpost_loop_2026test_multi"/>

          <!-- 保底选择成功，导致无限循环 -->
          <AlwaysSuccess/>
        </ReactiveFallback>
      </KeepRunningUntilFailure>                                                                             
    </Sequence>  
  </BehaviorTree>
</root>