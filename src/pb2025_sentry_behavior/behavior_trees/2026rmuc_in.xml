  <BehaviorTree ID="2026rmuc_in">
    <Sequence>
			<!-- 比赛开始条件，没收到裁判系统消息或在未开赛，都返回running -->
			<SubTree ID="check_game_started_2026rmuc_in"/>
			<!-- 比赛开始，先从起点去前哨 -->
			<SubTree ID="start_to_outpost_2026rmuc_in"/>
      <!-- 无限循环-->
      <KeepRunningUntilFailure>
        <!-- 反应式选择，下一轮tick无论前面节点啥状态，都会从头tick,直到有一个成功 -->
        <ReactiveFallback>

					<!-- 前哨血量小于20,进入守家策略；-->
					<Sequence>
						<Inverter>
							<IsOutpostHPHealthy outpost_hp_min="20" key_port="{@referee_allRobotHP}"/>
						</Inverter>
						<!-- 低前哨血时强制先回补给区，再进入堡垒-补给区往返，不允许回落到推前哨 -->
						<SequenceWithMemory>
							<SubTree ID="base_low_return_to_supply_2026rmuc_in"/>
							<Sleep msec="5000"/>
							<KeepRunningUntilFailure>
								<SubTree ID="supply_fort_loop_2026rmuc_in"/>
							</KeepRunningUntilFailure>
						</SequenceWithMemory>
					</Sequence>

					<!-- 前哨血量不低于20,进入推前哨策略-->
					<SubTree ID="supply_outpost_loop_2026rmuc_in"/>

          <!-- 保底选择成功，导致无限循环 -->
          <AlwaysSuccess/>
        </ReactiveFallback>
      </KeepRunningUntilFailure>                                                                             
    </Sequence>  
  </BehaviorTree>
